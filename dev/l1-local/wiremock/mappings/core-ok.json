{
  "name": "core OK",
  "request": {
    "method": "GET",
    "urlPath": "/api/support/fetchloandetailsv2",
    "headers": {
      "Authorization": {
        "matches": ".+"
      }
    },
    "queryParameters": {
      "loanRequestIds": {
        "matches": "LR-OK(-.*)?"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "core-ok.json"
  }
}