{
  "name": "axis timble (any customer)",
  "request": {
    "method": "POST",
    "urlPath": "/investor_integration/actions/invoke_api",
    "headers": {
      "API-key": {
        "matches": ".+"
      }
    },
    "queryParameters": {
      "type": {
        "equalTo": "dedupe_timble"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "status": "SUCCESS",
      "reference_id": "TIMBLE-LOCAL-1"
    }
  }
}