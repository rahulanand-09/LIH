{
  "taskRef": "rupeekweb.precheck.failure",
  "version": 1,
  "kind": "HTTP",
  "fields": {
    "resource": "rupeekweb",
    "method": "POST",
    "path": "=env.precheckFailurePath",
    "body": {
      "loanRequestId": "=inputs.loanRequestId",
      "lenderSlug": "=inputs.lender",
      "lendercustomerprofile": "=inputs.profileJson"
    },
    "idempotent": true,
    "success": "resp.status >= 200 && resp.status < 300",
    "classify": "resp.status == 429 || resp.status >= 500 ? 'TECHNICAL' : 'BUSINESS'",
    "onError": {
      "BUSINESS": "NOT_ACCEPTED"
    },
    "out": {}
  }
}
