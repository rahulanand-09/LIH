{
  "taskRef": "axis.precheck.saveDedupe",
  "version": 1,
  "kind": "MONGO",
  "fields": {
    "resource": "lendercore-mongo",
    "collection": "LenderCustomerPrecheck",
    "action": "UPSERT",
    "filter": {
      "loanRequestId": ":loanRequestId",
      "lenderSlug": "axis"
    },
    "setOnInsert": {
      "customerId": ":customerId",
      "responseMap": {},
      "creation_date": ":sys.now",
      "createdAt": ":sys.now",
      "_class": "com.rupeek.lender.entity.PrecheckEntity"
    },
    "set": {
      "applicantId": ":applicantId",
      "clientLoanId": ":clientLoanId",
      "precheckStatus": "processed",
      "approved": false,
      "last_updated": ":sys.now"
    },
    "inc": {
      "version": 1
    },
    "out": {
      "matched": "result.matched"
    }
  }
}
