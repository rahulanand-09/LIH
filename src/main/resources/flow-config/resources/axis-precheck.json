{
  "resource": "axis-precheck",
  "kind": "HTTP",
  "auth": { "type": "API_KEY_HEADER", "header": "API-key", "secretRef": "AXIS_PRECHECK_API_KEY" },
  "headers": { "Content-Type": "application/json", "Accept": "application/json, application/*+json" },
  "timeoutMs": { "connect": 120000, "read": 120000 },
  "pool": { "maxConnections": 20 },
  "env": {
    "local": { "baseUrlRef": "AXIS_PRECHECK_BASEURL", "values": { "preCheckAgreementId": "${AXIS_PRECHECK_AGREEMENT_ID}" } },
    "qa":    { "baseUrlRef": "AXIS_PRECHECK_BASEURL", "values": { "preCheckAgreementId": "${AXIS_PRECHECK_AGREEMENT_ID:2181}" } },
    "prod":  { "baseUrlRef": "AXIS_PRECHECK_BASEURL", "values": { "preCheckAgreementId": "${AXIS_PRECHECK_AGREEMENT_ID:323}" } }
  }
}
