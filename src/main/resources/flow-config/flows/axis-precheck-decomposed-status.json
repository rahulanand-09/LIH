{
  "flowRef": "axis-precheck-decomposed-status",
  "version": 2,
  "start": "existing",
  "nodes": [
    { "nodeType": "TASK", "id": "existing", "kind": "MONGO", "taskRef": "precheck.findByLoanRequest", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "none", "kind": "MAP", "taskRef": "axis.decomposed.status.none", "fields": {},
      "in": { "found": "$.existing.outputs.found" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "alreadyFinal", "kind": "MAP", "taskRef": "axis.decomposed.status.alreadyFinal", "fields": {},
      "in": { "doc": "$.existing.outputs.doc" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "request", "kind": "MAP", "taskRef": "map.axis.precheckStatusRequest", "fields": {},
      "in": { "doc": "$.existing.outputs.doc" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "call", "kind": "HTTP", "taskRef": "axis.precheck.status", "fields": {},
      "in": { "body": "$.request.outputs", "loanRequestId": "$.in.loanRequestId", "customerId": "$.existing.outputs.customerId" },
      "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "timbleFlag", "kind": "MAP", "taskRef": "axis.decomposed.status.timbleFlag", "fields": {},
      "in": { "doc": "$.existing.outputs.doc" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "decision", "kind": "MAP", "taskRef": "axis.decomposed.status.decision", "fields": {},
      "in": { "dedupe": "$.call.outputs.dedupe", "pan": "$.call.outputs.pan", "ramp": "$.call.outputs.ramp",
        "hunter": "$.call.outputs.hunter", "timbleFlag": "$.timbleFlag.outputs.value", "doc": "$.existing.outputs.doc" },
      "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "savePending", "kind": "MONGO", "taskRef": "axis.precheck.saveStatusPending", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "dedupe": "$.decision.outputs.dedupe", "pan": "$.decision.outputs.pan",
        "ramp": "$.decision.outputs.ramp", "hunter": "$.decision.outputs.hunter", "overall": "$.decision.outputs.overall" },
      "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "WAIT", "id": "pollDelay", "event": "statusPollTick", "timeout": "PT60S", "onTimeoutOutcome": "POLL" },
    { "nodeType": "SUBFLOW", "id": "persistSuccess", "flowRef": "axis-precheck-decomposed-status-persist",
      "in": { "loanRequestId": "$.in.loanRequestId", "dedupe": "$.decision.outputs.dedupe", "pan": "$.decision.outputs.pan",
        "ramp": "$.decision.outputs.ramp", "hunter": "$.decision.outputs.hunter", "overall": "$.decision.outputs.overall",
        "approvedFlag": "true", "precheckStatus": "success" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "SUBFLOW", "id": "persistFailure", "flowRef": "axis-precheck-decomposed-status-persist",
      "in": { "loanRequestId": "$.in.loanRequestId", "dedupe": "$.decision.outputs.dedupe", "pan": "$.decision.outputs.pan",
        "ramp": "$.decision.outputs.ramp", "hunter": "$.decision.outputs.hunter", "overall": "$.decision.outputs.overall",
        "approvedFlag": "false", "precheckStatus": "failure" }, "onError": { "retries": 1, "then": "PARK" } },

    { "nodeType": "END", "id": "noPrecheckEnd", "status": "NO_PRECHECK", "outputs": {} },
    { "nodeType": "END", "id": "alreadyFinalEnd", "status": "ALREADY_FINAL", "outputs": { "finalStatus": "$.alreadyFinal.outputs.finalStatus" } },
    { "nodeType": "END", "id": "alreadyFailedEnd", "status": "ALREADY_FAILED", "outputs": {} },
    { "nodeType": "END", "id": "success", "status": "SUCCESS", "outputs": {} },
    { "nodeType": "END", "id": "failure", "status": "FAILURE", "outputs": {} }
  ],
  "edges": [
    { "from": "existing", "on": "OK", "to": "none" },
    { "from": "none", "on": "NO_PRECHECK", "to": "noPrecheckEnd" },
    { "from": "none", "on": "HAS", "to": "alreadyFinal" },
    { "from": "alreadyFinal", "on": "ALREADY_FINAL", "to": "alreadyFinalEnd" },
    { "from": "alreadyFinal", "on": "ALREADY_FAILED", "to": "alreadyFailedEnd" },
    { "from": "alreadyFinal", "on": "CONTINUE", "to": "request" },
    { "from": "request", "on": "OK", "to": "call" },
    { "from": "call", "on": "OK", "to": "timbleFlag" },
    { "from": "timbleFlag", "on": "OK", "to": "decision" },
    { "from": "decision", "on": "PENDING", "to": "savePending" },
    { "from": "savePending", "on": "OK", "to": "pollDelay" },
    { "from": "pollDelay", "on": "POLL", "to": "existing" },
    { "from": "decision", "on": "SUCCESS", "to": "persistSuccess" },
    { "from": "persistSuccess", "on": "DONE", "to": "success" },
    { "from": "decision", "on": "FAILURE", "to": "persistFailure" },
    { "from": "persistFailure", "on": "DONE", "to": "failure" }
  ]
}
