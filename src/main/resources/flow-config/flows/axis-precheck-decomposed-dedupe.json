{
  "flowRef": "axis-precheck-decomposed-dedupe",
  "version": 2,
  "start": "fetchCoreAndStableId",
  "nodes": [
    { "nodeType": "SUBFLOW", "id": "fetchCoreAndStableId", "flowRef": "axis-precheck-decomposed-coreAndStableId",
      "inline": true, "in": { "loanRequestId": "$.in.loanRequestId", "runNo": "$.in.runNo" },
      "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "alreadyDone", "kind": "MAP", "taskRef": "axis.decomposed.dedupe.alreadyDone", "fields": {},
      "in": { "found": "$.fetchCoreAndStableId.outputs.found", "doc": "$.fetchCoreAndStableId.outputs.doc",
        "idsValue": "$.fetchCoreAndStableId.outputs.idsValue" },
      "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "inProgress", "kind": "MAP", "taskRef": "axis.decomposed.dedupe.inProgress", "fields": {},
      "in": { "found": "$.fetchCoreAndStableId.outputs.found", "doc": "$.fetchCoreAndStableId.outputs.doc",
        "idsValue": "$.fetchCoreAndStableId.outputs.idsValue" },
      "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "auditSkip", "kind": "MONGO", "taskRef": "precheck.audit.insert", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "customerId": "$.fetchCoreAndStableId.outputs.customerId", "loanProcess": "$.in.loanProcess",
        "status": "skip", "remarks": "API call skipped - Axis precheck already initiated and not yet completed" },
      "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "call_request", "kind": "MAP", "taskRef": "map.axis.precheckRequest", "fields": {},
      "in": { "customer": "$.fetchCoreAndStableId.outputs.customer", "clientLoanId": "$.fetchCoreAndStableId.outputs.idsValue" },
      "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "call", "kind": "HTTP", "taskRef": "axis.precheck.invoke", "fields": {},
      "in": { "body": "$.call_request.outputs", "loanRequestId": "$.in.loanRequestId",
        "customerId": "$.fetchCoreAndStableId.outputs.customerId" },
      "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "rejectedIsRerun", "kind": "MAP", "taskRef": "axis.decomposed.dedupe.isRerun", "fields": {},
      "in": { "found": "$.fetchCoreAndStableId.outputs.found" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "abortRemarks", "kind": "MAP", "taskRef": "axis.decomposed.dedupe.abortRemarks", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "auditAbort", "kind": "MONGO", "taskRef": "precheck.audit.insert", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "customerId": "$.fetchCoreAndStableId.outputs.customerId", "loanProcess": "$.in.loanProcess",
        "status": "failure", "remarks": "$.abortRemarks.outputs.remarks" },
      "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "isRerun", "kind": "MAP", "taskRef": "axis.decomposed.dedupe.isRerun", "fields": {},
      "in": { "found": "$.fetchCoreAndStableId.outputs.found" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "save", "kind": "MONGO", "taskRef": "axis.precheck.saveDedupe", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "customerId": "$.fetchCoreAndStableId.outputs.customerId",
        "applicantId": "$.call.outputs.applicantId", "clientLoanId": "$.fetchCoreAndStableId.outputs.idsValue" },
      "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "saveRerun", "kind": "MONGO", "taskRef": "axis.precheck.saveDedupeRerun", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "customerId": "$.fetchCoreAndStableId.outputs.customerId",
        "applicantId": "$.call.outputs.applicantId", "clientLoanId": "$.fetchCoreAndStableId.outputs.idsValue" },
      "onError": { "retries": 5, "then": "PARK" } },

    { "nodeType": "END", "id": "alreadyInitiated", "status": "ALREADY_INITIATED",
      "outputs": { "applicantId": "$.alreadyDone.outputs.applicantId", "clientLoanId": "$.alreadyDone.outputs.clientLoanId" } },
    { "nodeType": "END", "id": "inProgressEnd", "status": "IN_PROGRESS", "outputs": {} },
    { "nodeType": "END", "id": "rejected", "status": "REJECTED", "outputs": {} },
    { "nodeType": "END", "id": "aborted", "status": "ABORTED", "outputs": {} },
    { "nodeType": "END", "id": "initiated", "status": "INITIATED",
      "outputs": { "applicantId": "$.call.outputs.applicantId", "clientLoanId": "$.fetchCoreAndStableId.outputs.idsValue",
        "customerId": "$.fetchCoreAndStableId.outputs.customerId" } }
  ],
  "edges": [
    { "from": "fetchCoreAndStableId", "on": "OK", "to": "alreadyDone" },
    { "from": "alreadyDone", "on": "ALREADY_DONE", "to": "alreadyInitiated" },
    { "from": "alreadyDone", "on": "NOT_DONE", "to": "inProgress" },
    { "from": "inProgress", "on": "IN_PROGRESS", "to": "auditSkip" },
    { "from": "inProgress", "on": "CONTINUE", "to": "call_request" },
    { "from": "auditSkip", "on": "OK", "to": "inProgressEnd" },
    { "from": "call_request", "on": "OK", "to": "call" },
    { "from": "call", "on": "OK", "to": "isRerun" },
    { "from": "call", "on": "REJECTED", "to": "rejectedIsRerun" },
    { "from": "rejectedIsRerun", "on": "FRESH", "to": "rejected" },
    { "from": "rejectedIsRerun", "on": "RERUN", "to": "abortRemarks" },
    { "from": "abortRemarks", "on": "OK", "to": "auditAbort" },
    { "from": "auditAbort", "on": "OK", "to": "aborted" },
    { "from": "isRerun", "on": "FRESH", "to": "save" },
    { "from": "isRerun", "on": "RERUN", "to": "saveRerun" },
    { "from": "save", "on": "OK", "to": "initiated" },
    { "from": "saveRerun", "on": "OK", "to": "initiated" }
  ]
}
