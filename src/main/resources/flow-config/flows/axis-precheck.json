{
  "flowRef": "axis-precheck",
  "version": 1,
  "start": "d_core",
  "nodes": [
    { "nodeType": "WAIT", "id": "waitCallback", "event": "timbleCallback", "timeout": null, "onTimeoutOutcome": null },
    { "nodeType": "TASK", "id": "d_core", "kind": "HTTP", "taskRef": "core.fetchCustomerByLoanRequest", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "d_existing", "kind": "MONGO", "taskRef": "precheck.findByLoanRequest", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "d_ids", "kind": "GEN", "taskRef": "axis.precheck.dedupeStableId", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "runNo": "$.in.runNo" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "d_alreadyDone", "kind": "MAP", "taskRef": "axis.precheck.dedupeAlreadyDone", "fields": {},
      "in": { "found": "$.d_existing.outputs.found", "doc": "$.d_existing.outputs.doc", "idsValue": "$.d_ids.outputs.value" },
      "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "d_inProgressGuard", "kind": "MAP", "taskRef": "axis.decomposed.dedupe.inProgress", "fields": {},
      "in": { "found": "$.d_existing.outputs.found", "doc": "$.d_existing.outputs.doc", "idsValue": "$.d_ids.outputs.value" },
      "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "d_auditSkip", "kind": "MONGO", "taskRef": "precheck.audit.insert", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "customerId": "$.d_core.outputs.customerId", "loanProcess": "$.in.loanProcess",
        "status": "skip", "remarks": "API call skipped - Axis precheck already initiated and not yet completed" },
      "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "d_request", "kind": "MAP", "taskRef": "map.axis.precheckRequest", "fields": {},
      "in": { "customer": "$.d_core.outputs.customer", "clientLoanId": "$.d_ids.outputs.value" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "d_call", "kind": "HTTP", "taskRef": "axis.precheck.invoke", "fields": {},
      "in": { "body": "$.d_request.outputs" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "d_isRerun", "kind": "MAP", "taskRef": "axis.decomposed.dedupe.isRerun", "fields": {},
      "in": { "found": "$.d_existing.outputs.found" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "d_save", "kind": "MONGO", "taskRef": "axis.precheck.saveDedupe", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "customerId": "$.d_core.outputs.customerId",
        "applicantId": "$.d_call.outputs.applicantId", "clientLoanId": "$.d_ids.outputs.value" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "d_saveRerun", "kind": "MONGO", "taskRef": "axis.precheck.saveDedupeRerun", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "customerId": "$.d_core.outputs.customerId",
        "applicantId": "$.d_call.outputs.applicantId", "clientLoanId": "$.d_ids.outputs.value" }, "onError": { "retries": 5, "then": "PARK" } },

    { "nodeType": "TASK", "id": "t_core", "kind": "HTTP", "taskRef": "core.fetchCustomerByLoanRequest", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "t_existing", "kind": "MONGO", "taskRef": "precheck.findByLoanRequest", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "t_ids", "kind": "GEN", "taskRef": "axis.precheck.dedupeStableId", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "runNo": "$.in.runNo" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "t_alreadyDone", "kind": "MAP", "taskRef": "axis.precheck.timbleAlreadyDone", "fields": {},
      "in": { "found": "$.t_existing.outputs.found", "doc": "$.t_existing.outputs.doc", "idsValue": "$.t_ids.outputs.value" },
      "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "t_request", "kind": "MAP", "taskRef": "map.axis.precheckRequest", "fields": {},
      "in": { "customer": "$.t_core.outputs.customer", "clientLoanId": "$.t_ids.outputs.value" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "t_call", "kind": "HTTP", "taskRef": "axis.precheck.timble", "fields": {},
      "in": { "body": "$.t_request.outputs" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "t_save", "kind": "MONGO", "taskRef": "axis.precheck.saveTimbleRef", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "customerId": "$.t_core.outputs.customerId", "referenceId": "$.t_call.outputs.referenceId" },
      "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "t_audit", "kind": "MONGO", "taskRef": "axis.precheck.timbleAudit", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "customerId": "$.t_core.outputs.customerId", "loanProcess": "$.in.loanProcess",
        "remarks": "=\"Axis precheck initiated. applicantId=\" + (inputs.existingFound ? rk.str(inputs.existingDoc.?applicantId.orValue(null), 'null') : 'null') + \", clientLoanId=\" + (inputs.existingFound ? rk.str(inputs.existingDoc.?clientLoanId.orValue(null), 'null') : 'null') + \", timbleReferenceId=\" + rk.str(inputs.referenceId, 'null')",
        "existingFound": "$.t_existing.outputs.found", "existingDoc": "$.t_existing.outputs.doc", "referenceId": "$.t_call.outputs.referenceId" },
      "onError": { "retries": 5, "then": "PARK" } },

    { "nodeType": "TASK", "id": "tc_decide", "kind": "MAP", "taskRef": "axis.decomposed.timbleCallback.decide", "fields": {},
      "in": { "event": "$.waitCallback.outputs" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "tc_latest", "kind": "MONGO", "taskRef": "axis.precheck.timbleCallbackLatest", "fields": {},
      "in": { "customerId": "$.tc_decide.outputs.customerId" }, "onError": { "retries": 3, "then": "PARK" } },
    { "nodeType": "TASK", "id": "tc_noPrecheck", "kind": "MAP", "taskRef": "axis.precheck.timbleCallbackNoPrecheck", "fields": {},
      "in": { "found": "$.tc_latest.outputs.found" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "tc_save", "kind": "MONGO", "taskRef": "axis.precheck.saveTimbleStatus", "fields": {},
      "in": { "loanRequestId": "$.tc_latest.outputs.loanRequestId", "status": "$.tc_decide.outputs.status",
        "message": "$.tc_decide.outputs.message" }, "onError": { "retries": 3, "then": "PARK" } },
    { "nodeType": "TASK", "id": "tc_okCheck", "kind": "MAP", "taskRef": "axis.decomposed.timbleCallback.okCheck", "fields": {},
      "in": { "ok": "$.tc_decide.outputs.ok" }, "onError": { "retries": 1, "then": "PARK" } },

    { "nodeType": "TASK", "id": "s_existing", "kind": "MONGO", "taskRef": "precheck.findByLoanRequest", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "s_none", "kind": "MAP", "taskRef": "axis.precheck.statusNone", "fields": {},
      "in": { "found": "$.s_existing.outputs.found" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "s_alreadyFinal", "kind": "MAP", "taskRef": "axis.decomposed.status.alreadyFinal", "fields": {},
      "in": { "doc": "$.s_existing.outputs.doc" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "s_request", "kind": "MAP", "taskRef": "map.axis.precheckStatusRequest", "fields": {},
      "in": { "doc": "$.s_existing.outputs.doc" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "s_call", "kind": "HTTP", "taskRef": "axis.precheck.status", "fields": {},
      "in": { "body": "$.s_request.outputs" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "s_timbleFlag", "kind": "MAP", "taskRef": "axis.decomposed.status.timbleFlag", "fields": {},
      "in": { "doc": "$.s_existing.outputs.doc" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "s_decision", "kind": "MAP", "taskRef": "axis.precheck.statusDecision", "fields": {},
      "in": { "dedupe": "$.s_call.outputs.dedupe", "pan": "$.s_call.outputs.pan", "ramp": "$.s_call.outputs.ramp", "hunter": "$.s_call.outputs.hunter",
        "timbleFlag": "$.s_timbleFlag.outputs.value", "timble": "$.s_existing.outputs.doc" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "SUBFLOW", "id": "persistSuccess", "flowRef": "axis-precheck-decomposed-status-persist",
      "in": { "loanRequestId": "$.in.loanRequestId", "dedupe": "$.s_decision.outputs.dedupe", "pan": "$.s_decision.outputs.pan",
        "ramp": "$.s_decision.outputs.ramp", "hunter": "$.s_decision.outputs.hunter", "overall": "$.s_decision.outputs.overall",
        "approvedFlag": "true", "precheckStatus": "success" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "SUBFLOW", "id": "persistFailure", "flowRef": "axis-precheck-decomposed-status-persist",
      "in": { "loanRequestId": "$.in.loanRequestId", "dedupe": "$.s_decision.outputs.dedupe", "pan": "$.s_decision.outputs.pan",
        "ramp": "$.s_decision.outputs.ramp", "hunter": "$.s_decision.outputs.hunter", "overall": "$.s_decision.outputs.overall",
        "approvedFlag": "false", "precheckStatus": "failure" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "sPending_save", "kind": "MONGO", "taskRef": "axis.precheck.saveStatusPending", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "dedupe": "$.s_decision.outputs.dedupe", "pan": "$.s_decision.outputs.pan",
        "ramp": "$.s_decision.outputs.ramp", "hunter": "$.s_decision.outputs.hunter", "overall": "$.s_decision.outputs.overall" },
      "onError": { "retries": 5, "then": "PARK" } },

    { "nodeType": "TASK", "id": "notifyOk", "kind": "HTTP", "taskRef": "rupeekweb.precheck.verification", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId" }, "onError": { "retries": 3, "then": "PARK" } },

    { "nodeType": "TASK", "id": "nf_existing", "kind": "MONGO", "taskRef": "precheck.findByLoanRequest", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId" }, "onError": { "retries": 3, "then": "PARK" } },
    { "nodeType": "TASK", "id": "nf_buildProfileJson", "kind": "MAP", "taskRef": "axis.decomposed.notifyFail.buildProfileJson", "fields": {},
      "in": { "found": "$.nf_existing.outputs.found", "doc": "$.nf_existing.outputs.doc" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "nf_notify", "kind": "HTTP", "taskRef": "rupeekweb.precheck.failure", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "lender": "axis", "profileJson": "$.nf_buildProfileJson.outputs.profileJson" },
      "onError": { "retries": 3, "then": "PARK" } },

    { "nodeType": "END", "id": "approved", "status": "APPROVED" },
    { "nodeType": "END", "id": "rejected", "status": "REJECTED" },
    { "nodeType": "END", "id": "skipped", "status": "SKIPPED" }
  ],
  "edges": [
    { "from": "d_core", "on": "OK", "to": "d_existing" },
    { "from": "d_existing", "on": "OK", "to": "d_ids" },
    { "from": "d_ids", "on": "OK", "to": "d_alreadyDone" },
    { "from": "d_alreadyDone", "on": "ALREADY_INITIATED", "to": "t_core" },
    { "from": "d_alreadyDone", "on": "CONTINUE", "to": "d_inProgressGuard" },
    { "from": "d_inProgressGuard", "on": "IN_PROGRESS", "to": "d_auditSkip" },
    { "from": "d_inProgressGuard", "on": "CONTINUE", "to": "d_request" },
    { "from": "d_auditSkip", "on": "OK", "to": "skipped" },
    { "from": "d_request", "on": "OK", "to": "d_call" },
    { "from": "d_call", "on": "OK", "to": "d_isRerun" },
    { "from": "d_call", "on": "REJECTED", "to": "t_core" },
    { "from": "d_isRerun", "on": "FRESH", "to": "d_save" },
    { "from": "d_isRerun", "on": "RERUN", "to": "d_saveRerun" },
    { "from": "d_save", "on": "OK", "to": "t_core" },
    { "from": "d_saveRerun", "on": "OK", "to": "t_core" },

    { "from": "t_core", "on": "OK", "to": "t_existing" },
    { "from": "t_existing", "on": "OK", "to": "t_ids" },
    { "from": "t_ids", "on": "OK", "to": "t_alreadyDone" },
    { "from": "t_alreadyDone", "on": "ALREADY_INITIATED", "to": "waitCallback" },
    { "from": "t_alreadyDone", "on": "CONTINUE", "to": "t_request" },
    { "from": "t_request", "on": "OK", "to": "t_call" },
    { "from": "t_call", "on": "OK", "to": "t_save" },
    { "from": "t_call", "on": "REJECTED", "to": "rejected" },
    { "from": "t_save", "on": "OK", "to": "t_audit" },
    { "from": "t_audit", "on": "OK", "to": "waitCallback" },

    { "from": "waitCallback", "on": "RECEIVED", "to": "tc_decide" },
    { "from": "tc_decide", "on": "OK", "to": "tc_latest" },
    { "from": "tc_latest", "on": "OK", "to": "tc_noPrecheck" },
    { "from": "tc_noPrecheck", "on": "NO_PRECHECK", "to": "rejected" },
    { "from": "tc_noPrecheck", "on": "CONTINUE", "to": "tc_save" },
    { "from": "tc_save", "on": "OK", "to": "tc_okCheck" },
    { "from": "tc_okCheck", "on": "TIMBLE_OK", "to": "s_existing" },
    { "from": "tc_okCheck", "on": "TIMBLE_FAILED", "to": "s_existing" },

    { "from": "s_existing", "on": "OK", "to": "s_none" },
    { "from": "s_none", "on": "NO_PRECHECK", "to": "rejected" },
    { "from": "s_none", "on": "CONTINUE", "to": "s_alreadyFinal" },
    { "from": "s_alreadyFinal", "on": "ALREADY_FINAL", "to": "approved" },
    { "from": "s_alreadyFinal", "on": "CONTINUE", "to": "s_request" },
    { "from": "s_request", "on": "OK", "to": "s_call" },
    { "from": "s_call", "on": "OK", "to": "s_timbleFlag" },
    { "from": "s_timbleFlag", "on": "OK", "to": "s_decision" },
    { "from": "s_decision", "on": "SUCCESS", "to": "persistSuccess" },
    { "from": "s_decision", "on": "FAILURE", "to": "persistFailure" },
    { "from": "s_decision", "on": "PENDING", "to": "sPending_save" },
    { "from": "persistSuccess", "on": "DONE", "to": "notifyOk" },
    { "from": "persistFailure", "on": "DONE", "to": "nf_existing" },
    { "from": "sPending_save", "on": "OK", "to": "s_existing" },

    { "from": "notifyOk", "on": "OK", "to": "approved" },
    { "from": "notifyOk", "on": "NOT_ACCEPTED", "to": "approved" },

    { "from": "nf_existing", "on": "OK", "to": "nf_buildProfileJson" },
    { "from": "nf_buildProfileJson", "on": "OK", "to": "nf_notify" },
    { "from": "nf_notify", "on": "OK", "to": "rejected" },
    { "from": "nf_notify", "on": "NOT_ACCEPTED", "to": "rejected" }
  ]
}
