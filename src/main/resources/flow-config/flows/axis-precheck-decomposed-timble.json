{
  "flowRef": "axis-precheck-decomposed-timble",
  "version": 1,
  "start": "fetchCoreAndStableId",
  "nodes": [
    { "nodeType": "SUBFLOW", "id": "fetchCoreAndStableId", "flowRef": "axis-precheck-decomposed-coreAndStableId",
      "inline": true, "in": { "loanRequestId": "$.in.loanRequestId", "runNo": "$.in.runNo" },
      "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "alreadyDone", "kind": "MAP", "taskRef": "axis.decomposed.timble.alreadyDone", "fields": {},
      "in": { "found": "$.fetchCoreAndStableId.outputs.found", "doc": "$.fetchCoreAndStableId.outputs.doc",
        "idsValue": "$.fetchCoreAndStableId.outputs.idsValue" },
      "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "call_request", "kind": "MAP", "taskRef": "map.axis.precheckRequest", "fields": {},
      "in": { "customer": "$.fetchCoreAndStableId.outputs.customer", "clientLoanId": "$.fetchCoreAndStableId.outputs.idsValue" },
      "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "call", "kind": "HTTP", "taskRef": "axis.precheck.timble", "fields": {},
      "in": { "body": "$.call_request.outputs" },
      "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "save", "kind": "MONGO", "taskRef": "axis.precheck.saveTimbleRef", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "customerId": "$.fetchCoreAndStableId.outputs.customerId",
        "referenceId": "$.call.outputs.referenceId" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "audit_remarks", "kind": "MAP", "taskRef": "axis.decomposed.timble.auditRemarks", "fields": {},
      "in": { "applicantId": "$.in.applicantId", "clientLoanId": "$.fetchCoreAndStableId.outputs.idsValue",
        "referenceId": "$.call.outputs.referenceId" },
      "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "audit", "kind": "MONGO", "taskRef": "axis.decomposed.timble.audit", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "customerId": "$.fetchCoreAndStableId.outputs.customerId",
        "loanProcess": "$.in.loanProcess", "remarks": "$.audit_remarks.outputs.remarks" },
      "onError": { "retries": 5, "then": "PARK" } },

    { "nodeType": "END", "id": "alreadyInitiated", "status": "ALREADY_INITIATED",
      "outputs": { "timbleReferenceId": "$.alreadyDone.outputs.timbleReferenceId" } },
    { "nodeType": "END", "id": "rejected", "status": "REJECTED", "outputs": {} },
    { "nodeType": "END", "id": "initiated", "status": "INITIATED",
      "outputs": { "timbleReferenceId": "$.call.outputs.referenceId" } }
  ],
  "edges": [
    { "from": "fetchCoreAndStableId", "on": "OK", "to": "alreadyDone" },
    { "from": "alreadyDone", "on": "ALREADY_DONE", "to": "alreadyInitiated" },
    { "from": "alreadyDone", "on": "NOT_DONE", "to": "call_request" },
    { "from": "call_request", "on": "OK", "to": "call" },
    { "from": "call", "on": "OK", "to": "save" },
    { "from": "call", "on": "REJECTED", "to": "rejected" },
    { "from": "save", "on": "OK", "to": "audit_remarks" },
    { "from": "audit_remarks", "on": "OK", "to": "audit" },
    { "from": "audit", "on": "OK", "to": "initiated" }
  ]
}
