{
  "flowRef": "axis-precheck-decomposed-notifyFail",
  "version": 1,
  "start": "existing",
  "nodes": [
    { "nodeType": "TASK", "id": "existing", "kind": "MONGO", "taskRef": "precheck.findByLoanRequest", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId" }, "onError": { "retries": 3, "then": "PARK" } },
    { "nodeType": "TASK", "id": "buildProfileJson", "kind": "MAP", "taskRef": "axis.decomposed.notifyFail.buildProfileJson", "fields": {},
      "in": { "found": "$.existing.outputs.found", "doc": "$.existing.outputs.doc" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "notify", "kind": "HTTP", "taskRef": "rupeekweb.precheck.failure", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "lender": "$.in.lender", "profileJson": "$.buildProfileJson.outputs.profileJson" },
      "onError": { "retries": 3, "then": "PARK" } },

    { "nodeType": "END", "id": "notified", "status": "NOTIFIED", "outputs": {} },
    { "nodeType": "END", "id": "notAccepted", "status": "NOT_ACCEPTED", "outputs": {} }
  ],
  "edges": [
    { "from": "existing", "on": "OK", "to": "buildProfileJson" },
    { "from": "buildProfileJson", "on": "OK", "to": "notify" },
    { "from": "notify", "on": "OK", "to": "notified" },
    { "from": "notify", "on": "NOT_ACCEPTED", "to": "notAccepted" }
  ]
}
