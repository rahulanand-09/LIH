{
  "lender": "axis",
  "operations": {
    "dedupe": {
      "protocol": "REST", "method": "POST",
      "url": "${AXIS_PRECHECK_URL}",
      "query": { "type": "dedupe" },
      "headers": { "API-key": "${AXIS_PRECHECK_API_KEY}" },
      "transformer": "axisPrecheckRequest",
      "extract": {
        "applicantId": "data?.applicantId",
        "valid": "data != null and (errors == null or errors.isEmpty())"
      }
    },
    "timble": {
      "protocol": "REST", "method": "POST",
      "url": "${AXIS_PRECHECK_URL}",
      "query": { "type": "dedupe_timble" },
      "headers": { "API-key": "${AXIS_PRECHECK_API_KEY}" },
      "transformer": "axisPrecheckRequest",
      "extract": { "referenceId": "reference_id" }
    },
    "status": {
      "protocol": "REST", "method": "POST",
      "url": "${AXIS_PRECHECK_URL}",
      "query": { "type": "dedupe_status" },
      "headers": { "API-key": "${AXIS_PRECHECK_API_KEY}" },
      "transformer": "axisStatusRequest",
      "extract": { "dedupe": "dedupe", "pan": "pan", "ramp": "ramp", "hunter": "hunter" }
    }
  },
  "callbacks": {
    "YUBI_TIMBLE_STATUS": {
      "event": "timbleCallback",
      "correlateOn": "customer_id",
      "okVar": "timbleOk",
      "fields": ["product_id", "customer_id", "timble_status", "name_match", "aadhar_match", "timble_error_message"]
    }
  }
}
