{
  "name": "timble callback: ' n ' counts as N (trimmed, any case); absent keys are left out of the message",
  "recipe": "axis.precheck.timbleCallback",
  "input": {
    "event": {
      "product_id": "P1",
      "customer_id": "CUST-TEST-1",
      "timble_status": "COMPLETED",
      "name_match": "Y",
      "aadhar_match": " n "
    }
  },
  "mocks": {
    "precheck.findLatestByCustomer@1": {
      "result": {
        "loanRequestId": "LR-9",
        "customerId": "CUST-TEST-1"
      }
    }
  },
  "expect": {
    "outcome": "TIMBLE_FAILED",
    "calls": {
      "axis.precheck.saveTimbleStatus@1": {
        "params.message": "Timble Precheck Failure : {\"aadhar_match\":\" n \",\"name_match\":\"Y\"}"
      }
    }
  }
}
