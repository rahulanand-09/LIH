{
  "name": "dedupe: a completed earlier attempt is re-run with a NEW client_loan_id",
  "recipe": "axis.precheck.dedupe",
  "input": {
    "loanRequestId": "LR-GOLDEN-1",
    "runNo": 2,
    "loanProcess": "fresh"
  },
  "mocks": {
    "core.fetchCustomerByLoanRequest@1": {
      "resp": {
        "status": 200,
        "body": {
          "UserMsg": "SUCCESS",
          "loandata": [
            {
              "customer": {
                "id": "CUST-TEST-1",
                "firstName": "Ravi",
                "lastName": "Sharma",
                "customerProofName": "Ravi Kumar Sharma",
                "customerPanName": "RAVI KUMAR SHARMA",
                "customerPhone": "9000000001",
                "email": "ravi.test@example.com",
                "gender": "M",
                "dob": "1990-01-05",
                "aadhar": "000011112222",
                "pan": "ABCDE1234F",
                "customerAddress": "  12,  MG Road   Bengaluru ",
                "permanentAddress": {
                  "city": "Bengaluru",
                  "state": "Karnataka",
                  "pin": "560001"
                },
                "presentAddress": {
                  "city": "Mysuru",
                  "state": "Karnataka",
                  "pin": "570001"
                }
              }
            }
          ]
        }
      }
    },
    "axis.precheck.invoke@1": {
      "resp": {
        "status": 200,
        "body": {
          "data": {
            "applicantId": "APP-TEST-9",
            "consumerLoanApplicationRefId": "REF-TEST-9",
            "onBoardingInProgress": "N"
          },
          "code": "200",
          "message": "ok"
        }
      }
    },
    "precheck.findByLoanRequest@1": {
      "result": {
        "loanRequestId": "LR-GOLDEN-1",
        "clientLoanId": "d0964d53-e978-5ab5-a2d7-dc7ec85e5dc4",
        "applicantId": "APP-OLD",
        "responseMap": {
          "axisPreCheckStatus": {
            "status": "FAILURE",
            "statusMessage": "x"
          }
        }
      }
    }
  },
  "expect": {
    "outcome": "INITIATED",
    "out": {
      "clientLoanId": "e385eadf-1d4f-5c69-8bcf-0992d33d30b9"
    },
    "calls": {
      "axis.precheck.invoke@1": {
        "params.body.client_loan_id": "e385eadf-1d4f-5c69-8bcf-0992d33d30b9"
      },
      "axis.precheck.saveDedupeRerun@1": {
        "params.clientLoanId": "e385eadf-1d4f-5c69-8bcf-0992d33d30b9"
      }
    },
    "notCalled": [
      "axis.precheck.saveDedupe@1"
    ]
  }
}
