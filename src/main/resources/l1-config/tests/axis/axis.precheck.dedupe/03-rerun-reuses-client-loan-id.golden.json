{
  "name": "earlier run stored an id but no applicantId: the same client_loan_id is sent again",
  "recipe": "axis.precheck.dedupe",
  "input": {
    "loanRequestId": "LR-GOLDEN-1",
    "runNo": 1
  },
  "mocks": {
    "core.fetchCustomerByLoanRequest@1": {
      "resp": {
        "status": 200,
        "body": {
          "UserMsg": "SUCCESS",
          "loandata": [
            {
              "customer": {
                "id": "CUST-TEST-1",
                "firstName": "Ravi",
                "lastName": "Sharma",
                "customerProofName": "Ravi Kumar Sharma",
                "customerPanName": "RAVI KUMAR SHARMA",
                "customerPhone": "9000000001",
                "email": "ravi.test@example.com",
                "gender": "M",
                "dob": "1990-01-05",
                "aadhar": "000011112222",
                "pan": "ABCDE1234F",
                "customerAddress": "  12,  MG Road   Bengaluru ",
                "permanentAddress": {
                  "city": "Bengaluru",
                  "state": "Karnataka",
                  "pin": "560001"
                },
                "presentAddress": {
                  "city": "Mysuru",
                  "state": "Karnataka",
                  "pin": "570001"
                }
              }
            }
          ]
        }
      }
    },
    "precheck.findByLoanRequest@1": {
      "result": {
        "client_loan_id": "CL-KEEP"
      }
    },
    "axis.precheck.invoke@1": {
      "resp": {
        "status": 200,
        "body": {
          "data": {
            "applicantId": "APP-TEST-9",
            "consumerLoanApplicationRefId": "REF-TEST-9",
            "onBoardingInProgress": "N"
          },
          "code": "200",
          "message": "ok"
        }
      }
    }
  },
  "expect": {
    "outcome": "INITIATED",
    "out": {
      "clientLoanId": "CL-KEEP"
    },
    "calls": {
      "axis.precheck.invoke@1": {
        "params.body.client_loan_id": "CL-KEEP"
      },
      "precheck.upsertInitiated@1": {
        "params.clientLoanId": "CL-KEEP"
      }
    }
  }
}
