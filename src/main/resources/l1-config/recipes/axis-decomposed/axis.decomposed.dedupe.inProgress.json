{
  "recipe": "axis.decomposed.dedupe.inProgress",
  "lender": "axis",
  "inputs": { "found": "bool", "doc": "map", "idsValue": "string" },
  "outputs": {},
  "outcomes": ["IN_PROGRESS", "CONTINUE"],
  "steps": [
    { "id": "check",
      "when": "input.found && rk.str(input.doc.?clientLoanId.orValue(''), '') != input.idsValue && !(rk.str(input.doc.?responseMap.?axisPreCheckStatus.?status.orValue(null), '').upperAscii() in ['SUCCESS', 'FAILURE'])",
      "return": { "outcome": "IN_PROGRESS" } }
  ],
  "return": { "outcome": "CONTINUE" }
}
