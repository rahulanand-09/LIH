{
  "recipe": "axis.decomposed.timble.alreadyDone",
  "lender": "axis",
  "inputs": { "found": "bool", "doc": "map", "idsValue": "string" },
  "outputs": { "timbleReferenceId": "string" },
  "outcomes": ["ALREADY_DONE", "NOT_DONE"],
  "steps": [
    { "id": "check",
      "when": "input.found && rk.str(input.doc.?clientLoanId.orValue(''), '') == input.idsValue && rk.str(input.doc.?reference_id.orValue(null), '') != ''",
      "return": { "outcome": "ALREADY_DONE", "out": { "timbleReferenceId": "input.doc.reference_id" } } }
  ],
  "return": { "outcome": "NOT_DONE" }
}
