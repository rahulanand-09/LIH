{
  "recipe": "axis.decomposed.dedupe.alreadyDone",
  "lender": "axis",
  "inputs": { "found": "bool", "doc": "map", "idsValue": "string" },
  "outputs": { "applicantId": "string", "clientLoanId": "string" },
  "outcomes": ["ALREADY_DONE", "NOT_DONE"],
  "steps": [
    { "id": "check",
      "when": "input.found && rk.str(input.doc.?clientLoanId.orValue(''), '') == input.idsValue && rk.str(input.doc.?applicantId.orValue(null), '') != ''",
      "return": { "outcome": "ALREADY_DONE", "out": { "applicantId": "input.doc.applicantId", "clientLoanId": "input.idsValue" } } }
  ],
  "return": { "outcome": "NOT_DONE" }
}
