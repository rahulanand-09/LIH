{
  "recipe": "axis.decomposed.status.timbleFlag",
  "lender": "axis",
  "inputs": { "doc": "map" },
  "outputs": { "value": "string" },
  "outcomes": ["OK"],
  "steps": [
    { "id": "flag", "op": "map.value@1", "in": {
        "value": "input.doc.?responseMap.?timble.orValue(null) != null ? (rk.str(input.doc.responseMap.timble.?status.orValue(null), 'FAILURE').upperAscii() == 'SUCCESS' ? 'Y' : 'N') : 'WIP'" } }
  ],
  "return": { "outcome": "OK", "out": { "value": "steps.flag.value" } }
}
