{
  "recipe": "axis.decomposed.buildSeed",
  "lender": "axis",
  "inputs": { "loanRequestId": "string", "runNo": "int" },
  "outputs": { "value": "string" },
  "outcomes": ["OK"],
  "steps": [
    { "id": "seed", "op": "map.value@1", "in": { "value": "input.loanRequestId + ':r' + string(input.runNo) + ':axis-dedupe'" } }
  ],
  "return": { "outcome": "OK", "out": { "value": "steps.seed.value" } }
}
