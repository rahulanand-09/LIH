{
  "recipe": "axis.precheck.timbleCallback",
  "lender": "axis",
  "inputs": {
    "event": "map"
  },
  "outputs": {
    "customerId": "string",
    "loanRequestId": "string",
    "timbleOk": "bool"
  },
  "outcomes": [
    "TIMBLE_OK",
    "TIMBLE_FAILED",
    "NO_PRECHECK"
  ],
  "auditKeys": {
    "customerId": "rk.str(input.event.?customer_id.orValue(null))"
  },
  "steps": [
    {
      "id": "decide",
      "op": "map.value@1",
      "in": {
        "value": "cel.bind(n, rk.str(input.event.?name_match.orValue(null), '').trim().upperAscii(), cel.bind(a, rk.str(input.event.?aadhar_match.orValue(null), '').trim().upperAscii(), cel.bind(ok, !(n == 'N' || a == 'N'), {'ok': ok, 'customerId': rk.str(input.event.?customer_id.orValue(null), ''), 'status': ok ? 'SUCCESS' : 'FAILURE', 'message': ok ? 'Timble Precheck Successful' : 'Timble Precheck Failure : ' + rk.json({?'timble_error_message': input.event.?timble_error_message, ?'aadhar_match': input.event.?aadhar_match, ?'name_match': input.event.?name_match})})))"
      }
    },
    {
      "id": "latest",
      "op": "precheck.findLatestByCustomer@1",
      "in": {
        "customerId": "steps.decide.value.customerId",
        "lender": "'axis'"
      }
    },
    {
      "id": "noPrecheck",
      "when": "!steps.latest.found",
      "return": {
        "outcome": "NO_PRECHECK",
        "out": {
          "customerId": "steps.decide.value.customerId",
          "timbleOk": "steps.decide.value.ok"
        }
      }
    },
    {
      "id": "save",
      "op": "axis.precheck.saveTimbleStatus@1",
      "in": {
        "loanRequestId": "steps.latest.doc.loanRequestId",
        "lender": "'axis'",
        "status": "steps.decide.value.status",
        "message": "steps.decide.value.message"
      }
    },
    {
      "id": "failed",
      "when": "!steps.decide.value.ok",
      "return": {
        "outcome": "TIMBLE_FAILED",
        "out": {
          "customerId": "steps.decide.value.customerId",
          "loanRequestId": "steps.latest.doc.loanRequestId",
          "timbleOk": "false"
        }
      }
    }
  ],
  "return": {
    "outcome": "TIMBLE_OK",
    "out": {
      "customerId": "steps.decide.value.customerId",
      "loanRequestId": "steps.latest.doc.loanRequestId",
      "timbleOk": "true"
    }
  }
}
