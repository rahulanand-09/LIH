{
  "recipe": "axis.precheck.timble",
  "lender": "axis",
  "inputs": {
    "loanRequestId": "string",
    "runNo": "int",
    "loanProcess": "string"
  },
  "outputs": {
    "timbleReferenceId": "string"
  },
  "outcomes": [
    "INITIATED",
    "ALREADY_INITIATED",
    "REJECTED"
  ],
  "auditKeys": {
    "loanRequestId": "input.loanRequestId",
    "customerId": "steps.?core.?customer.?id.orValue(null)"
  },
  "steps": [
    {
      "id": "core",
      "op": "core.fetchCustomerByLoanRequest@1",
      "in": {
        "loanRequestId": "input.loanRequestId"
      }
    },
    {
      "id": "existing",
      "op": "precheck.findByLoanRequest@1",
      "in": {
        "loanRequestId": "input.loanRequestId",
        "lender": "'axis'"
      }
    },
    {
      "id": "ids",
      "op": "gen.stableId@1",
      "in": {
        "reuse": "''",
        "seed": "input.loanRequestId + ':r' + string(input.runNo) + ':axis-dedupe'"
      }
    },
    {
      "id": "alreadyDone",
      "when": "steps.existing.found && steps.existing.doc.?clientLoanId.orValue('') == steps.ids.value && rk.str(steps.existing.doc.?reference_id.orValue(null), '') != ''",
      "return": {
        "outcome": "ALREADY_INITIATED",
        "out": {
          "timbleReferenceId": "steps.existing.doc.reference_id"
        }
      }
    },
    {
      "id": "request",
      "op": "map.axis.precheckRequest@1",
      "in": {
        "customer": "steps.core.customer",
        "clientLoanId": "steps.ids.value"
      }
    },
    {
      "id": "call",
      "op": "axis.precheck.timble@1",
      "in": {
        "body": "steps.request.value"
      },
      "onError": {
        "BUSINESS": "return:REJECTED"
      }
    },
    {
      "id": "save",
      "op": "axis.precheck.saveTimbleRef@1",
      "in": {
        "loanRequestId": "input.loanRequestId",
        "lender": "'axis'",
        "customerId": "rk.str(steps.core.customer.id)",
        "referenceId": "steps.call.referenceId"
      }
    },
    {
      "id": "audit",
      "op": "precheck.audit.insert@1",
      "in": {
        "loanRequestId": "input.loanRequestId",
        "lender": "'axis'",
        "customerId": "rk.str(steps.core.customer.id)",
        "loanProcess": "input.loanProcess",
        "status": "'processed'",
        "remarks": "'Axis precheck initiated. applicantId=' + (steps.existing.found ? rk.str(steps.existing.doc.?applicantId.orValue(null), 'null') : 'null') + ', clientLoanId=' + (steps.existing.found ? rk.str(steps.existing.doc.?clientLoanId.orValue(null), 'null') : 'null') + ', timbleReferenceId=' + rk.str(steps.call.referenceId, 'null')"
      }
    }
  ],
  "return": {
    "outcome": "INITIATED",
    "out": {
      "timbleReferenceId": "steps.call.referenceId"
    }
  }
}
