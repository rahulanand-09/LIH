{
  "recipe": "precheck.notify.failed",
  "inputs": {
    "loanRequestId": "string",
    "lender": "string"
  },
  "outcomes": [
    "NOTIFIED",
    "NOT_ACCEPTED"
  ],
  "auditKeys": {
    "loanRequestId": "input.loanRequestId"
  },
  "steps": [
    {
      "id": "existing",
      "op": "precheck.findByLoanRequest@1",
      "in": {
        "loanRequestId": "input.loanRequestId",
        "lender": "input.lender"
      }
    },
    {
      "id": "profile",
      "op": "map.precheck.lenderCustomerProfile@1",
      "when": "steps.existing.found",
      "in": {
        "doc": "steps.existing.doc"
      }
    },
    {
      "id": "notify",
      "op": "rupeekweb.precheck.failure@1",
      "in": {
        "loanRequestId": "input.loanRequestId",
        "lender": "input.lender",
        "profileJson": "steps.existing.found ? rk.json(steps.profile.value) : '{}'"
      },
      "onError": {
        "BUSINESS": "return:NOT_ACCEPTED"
      }
    }
  ],
  "return": {
    "outcome": "NOTIFIED"
  }
}
