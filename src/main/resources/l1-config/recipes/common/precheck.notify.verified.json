{
  "recipe": "precheck.notify.verified",
  "inputs": {
    "loanRequestId": "string"
  },
  "outcomes": [
    "NOTIFIED",
    "NOT_ACCEPTED"
  ],
  "auditKeys": {
    "loanRequestId": "input.loanRequestId"
  },
  "steps": [
    {
      "id": "notify",
      "op": "rupeekweb.precheck.verification@1",
      "in": {
        "loanRequestId": "input.loanRequestId",
        "approved": "true"
      },
      "onError": {
        "BUSINESS": "return:NOT_ACCEPTED"
      }
    }
  ],
  "return": {
    "outcome": "NOTIFIED"
  }
}
