{
  "op": "precheck.upsertInitiated",
  "kind": "MONGO",
  "resource": "lendercore-mongo",
  "params": {
    "loanRequestId": { "type": "string" }, "lender": { "type": "string" },
    "customerId": { "type": "string" }, "clientLoanId": { "type": "string" }
  },
  "collection": "LenderCustomerPrecheck",
  "action": "UPSERT",
  "filter": { "loanRequestId": ":loanRequestId", "lenderSlug": ":lender" },
  "setOnInsert": {
    "customerId": ":customerId", "precheckStatus": "initiated", "approved": false, "responseMap": {},
    "creation_date": ":sys.now", "createdAt": ":sys.now", "_class": "com.rupeek.lender.entity.PrecheckEntity"
  },
  "set": { "client_loan_id": ":clientLoanId", "last_updated": ":sys.now" },
  "inc": { "version": 1 },
  "out": { "matched": "result.matched", "upsertedId": "result.upsertedId" }
}
