{
  "op": "rupeekweb.precheck.verification",
  "kind": "HTTP",
  "resource": "rupeekweb",
  "params": {
    "loanRequestId": {
      "type": "string"
    },
    "approved": {
      "type": "bool"
    }
  },
  "request": {
    "method": "POST",
    "path": "=env.precheckVerificationPath",
    "bodyEncoding": "FORM",
    "body": {
      "loanrequestId": "=params.loanRequestId",
      "approved": "=string(params.approved)"
    }
  },
  "idempotent": true,
  "success": "resp.status >= 200 && resp.status < 300",
  "classify": "resp.status == 429 || resp.status >= 500 ? 'TECHNICAL' : 'BUSINESS'",
  "out": {
    "status": "resp.status"
  }
}
