{
  "op": "precheck.findLatestByCustomer",
  "kind": "MONGO",
  "resource": "lendercore-mongo",
  "params": {
    "customerId": {
      "type": "string"
    },
    "lender": {
      "type": "string"
    }
  },
  "collection": "LenderCustomerPrecheck",
  "action": "FIND_ONE",
  "filter": {
    "customerId": ":customerId",
    "lenderSlug": ":lender"
  },
  "sort": {
    "creation_date": -1
  },
  "out": {
    "found": "result != null",
    "doc": "result"
  }
}
