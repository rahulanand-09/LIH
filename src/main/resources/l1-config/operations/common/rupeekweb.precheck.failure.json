{
  "op": "rupeekweb.precheck.failure",
  "kind": "HTTP",
  "resource": "rupeekweb",
  "params": {
    "loanRequestId": {
      "type": "string"
    },
    "lender": {
      "type": "string"
    },
    "profileJson": {
      "type": "string"
    }
  },
  "request": {
    "method": "POST",
    "path": "=env.precheckFailurePath",
    "body": {
      "loanRequestId": "=params.loanRequestId",
      "lenderSlug": "=params.lender",
      "lendercustomerprofile": "=params.profileJson"
    }
  },
  "idempotent": true,
  "success": "resp.status >= 200 && resp.status < 300",
  "classify": "resp.status == 429 || resp.status >= 500 ? 'TECHNICAL' : 'BUSINESS'",
  "out": {
    "status": "resp.status"
  }
}
