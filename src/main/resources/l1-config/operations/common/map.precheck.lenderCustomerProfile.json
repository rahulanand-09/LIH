{
  "op": "map.precheck.lenderCustomerProfile",
  "kind": "MAP",
  "params": {
    "doc": {
      "type": "map"
    }
  },
  "template": {
    "id": "=params.doc.?_id.orValue(null)",
    "loanRequestId": "=params.doc.?loanRequestId.orValue(null)",
    "customerId": "=params.doc.?customerId.orValue(null)",
    "precheckStatus": "=params.doc.?precheckStatus.orValue(null)",
    "lenderSlug": "=params.doc.?lenderSlug.orValue(null)",
    "lenderCustomerId": "=params.doc.?lenderCustomerId.orValue(null)",
    "rejectionReason": "=params.doc.?rejectionReason.orValue(null)",
    "responseMap": {
      "customerAcceptanceStatus": "=params.doc.?responseMap.?customerAcceptanceStatus.orValue(null)",
      "customerBlacklistStatus": "=params.doc.?responseMap.?customerBlacklistStatus.orValue(null)",
      "axisPreCheckStatus": "=params.doc.?responseMap.?axisPreCheckStatus.hasValue() ? dyn({'status': params.doc.?responseMap.axisPreCheckStatus.?status.orValue(null), 'statusMessage': params.doc.?responseMap.axisPreCheckStatus.?statusMessage.orValue(null)}) : null",
      "dedupe": "=params.doc.?responseMap.?dedupe.hasValue() ? dyn({'status': params.doc.?responseMap.dedupe.?status.orValue(null), 'statusMessage': params.doc.?responseMap.dedupe.?statusMessage.orValue(null)}) : null",
      "pan": "=params.doc.?responseMap.?pan.hasValue() ? dyn({'status': params.doc.?responseMap.pan.?status.orValue(null), 'statusMessage': params.doc.?responseMap.pan.?statusMessage.orValue(null)}) : null",
      "ramp": "=params.doc.?responseMap.?ramp.hasValue() ? dyn({'status': params.doc.?responseMap.ramp.?status.orValue(null), 'statusMessage': params.doc.?responseMap.ramp.?statusMessage.orValue(null)}) : null",
      "hunter": "=params.doc.?responseMap.?hunter.hasValue() ? dyn({'status': params.doc.?responseMap.hunter.?status.orValue(null), 'statusMessage': params.doc.?responseMap.hunter.?statusMessage.orValue(null)}) : null",
      "timble": "=params.doc.?responseMap.?timble.hasValue() ? dyn({'status': params.doc.?responseMap.timble.?status.orValue(null), 'statusMessage': params.doc.?responseMap.timble.?statusMessage.orValue(null)}) : null"
    },
    "approved": "=params.doc.?approved.orValue(false)",
    "retry": "=params.doc.?retry.orValue(null)",
    "overallstpstatus": "=params.doc.?overallstpstatus.orValue(null)",
    "unsecurestpstatus": "=params.doc.?unsecurestpstatus.orValue(null)",
    "stpstatus": "=params.doc.?stpstatus.orValue(null)",
    "lenderstpstatus": "=params.doc.?lenderstpstatus.orValue(null)",
    "autofundtransferstatus": "=params.doc.?autofundtransferstatus.orValue(null)",
    "applicantId": "=params.doc.?applicantId.orValue(null)",
    "client_loan_id": "=params.doc.?clientLoanId.orValue(null)",
    "loanProcess": "=params.doc.?loan_process.orValue(null)",
    "timbleReferenceId": "=params.doc.?reference_id.orValue(null)"
  },
  "out": {
    "value": "result"
  }
}
