{
  "op": "axis.precheck.saveTimbleRef",
  "kind": "MONGO",
  "resource": "lendercore-mongo",
  "params": {
    "loanRequestId": {
      "type": "string"
    },
    "lender": {
      "type": "string"
    },
    "customerId": {
      "type": "string"
    },
    "referenceId": {
      "type": "string"
    }
  },
  "collection": "LenderCustomerPrecheck",
  "action": "UPSERT",
  "filter": {
    "loanRequestId": ":loanRequestId",
    "lenderSlug": ":lender"
  },
  "setOnInsert": {
    "customerId": ":customerId",
    "responseMap": {},
    "approved": false,
    "creation_date": ":sys.now",
    "createdAt": ":sys.now",
    "_class": "com.rupeek.lender.entity.PrecheckEntity"
  },
  "set": {
    "reference_id": ":referenceId",
    "last_updated": ":sys.now"
  },
  "inc": {
    "version": 1
  },
  "out": {
    "matched": "result.matched"
  }
}
