{
  "op": "axis.precheck.status",
  "kind": "HTTP",
  "resource": "axis-precheck",
  "params": {
    "body": {
      "type": "map"
    }
  },
  "request": {
    "method": "POST",
    "path": "/investor_integration/actions/invoke_api",
    "query": {
      "type": "dedupe_status"
    },
    "body": "=params.body"
  },
  "idempotent": true,
  "success": "resp.status == 200 && [resp.body.?dedupe.orValue(''), resp.body.?pan.orValue(''), resp.body.?ramp.orValue(''), resp.body.?hunter.orValue('')].all(f, f in ['Y', 'WIP', 'N'])",
  "classify": "resp.status == 429 || resp.status >= 500 ? 'TECHNICAL' : 'PERMANENT'",
  "out": {
    "dedupe": "resp.body.dedupe",
    "pan": "resp.body.pan",
    "ramp": "resp.body.ramp",
    "hunter": "resp.body.hunter"
  },
  "audit": "PRECHECK_STATUS"
}
