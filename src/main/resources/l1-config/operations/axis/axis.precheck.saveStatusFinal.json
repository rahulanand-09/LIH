{
  "op": "axis.precheck.saveStatusFinal",
  "kind": "MONGO",
  "resource": "lendercore-mongo",
  "params": {
    "loanRequestId": {
      "type": "string"
    },
    "lender": {
      "type": "string"
    },
    "dedupe": {
      "type": "map"
    },
    "pan": {
      "type": "map"
    },
    "ramp": {
      "type": "map"
    },
    "hunter": {
      "type": "map"
    },
    "overall": {
      "type": "map"
    },
    "approved": {
      "type": "bool"
    }
  },
  "collection": "LenderCustomerPrecheck",
  "action": "UPDATE_ONE",
  "filter": {
    "loanRequestId": ":loanRequestId",
    "lenderSlug": ":lender"
  },
  "set": {
    "responseMap.pan": ":pan",
    "responseMap.hunter": ":hunter",
    "responseMap.dedupe": ":dedupe",
    "responseMap.ramp": ":ramp",
    "responseMap.axisPreCheckStatus": ":overall",
    "last_updated": ":sys.now",
    "approved": ":approved"
  },
  "inc": {
    "version": 1
  },
  "expect": {
    "matched": 1
  },
  "out": {
    "matched": "result.matched"
  }
}
