{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rupeek.com/l1/recipe.schema.json",
  "title": "L1 recipe",
  "description": "One lender step: ordered steps, guards, early returns, declared outcomes and outputs. Values of auditKeys, when, in and out are CEL.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipe", "outcomes", "steps", "return"],
  "properties": {
    "recipe": { "$ref": "#/$defs/ref", "description": "<lender>.<process>.<step>, e.g. axis.precheck.dedupe" },
    "version": { "type": "integer", "minimum": 1, "description": "Bump by one for every change; published versions are immutable" },
    "lender": { "type": "string", "description": "Lender slug for audit and metrics only" },
    "resources": { "type": "object", "additionalProperties": { "type": "string" }, "description": "alias -> resource id; gives env.<alias>.<key>" },
    "inputs": { "$ref": "#/$defs/typeMap" },
    "outputs": { "$ref": "#/$defs/typeMap" },
    "outcomes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/outcome" } },
    "auditKeys": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cel" } },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "return": { "$ref": "#/$defs/return" }
  },
  "$defs": {
    "ref": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-zA-Z0-9_-]+)+$" },
    "cel": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "outcome": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "typeMap": {
      "type": "object",
      "additionalProperties": { "enum": ["string", "int", "double", "bool", "map", "list", "dyn"] }
    },
    "return": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": { "$ref": "#/$defs/outcome" },
        "out": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cel" } }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "op": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-zA-Z0-9_-]+)+@[1-9][0-9]*$", "description": "ref@version" },
        "when": { "$ref": "#/$defs/cel" },
        "in": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cel" } },
        "return": { "$ref": "#/$defs/return" },
        "onError": {
          "type": "object",
          "propertyNames": { "enum": ["TECHNICAL", "BUSINESS", "UNKNOWN", "PERMANENT"] },
          "additionalProperties": { "type": "string", "pattern": "^(raise|return:[A-Z][A-Z0-9_]*)$" }
        }
      },
      "oneOf": [ { "required": ["op"] }, { "required": ["return"] } ]
    }
  }
}
