{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rupeek.com/l1/resource.schema.json",
  "title": "L1 resource",
  "description": "Where operations run and with which credentials. Live config: not versioned, not pinned per case.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource", "kind"],
  "properties": {
    "resource": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "kind": { "enum": ["HTTP", "MONGO"] },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["NONE", "API_KEY_HEADER", "STATIC_BEARER"] },
        "header": { "type": "string" },
        "secretRef": { "$ref": "#/$defs/varName" }
      }
    },
    "headers": { "type": "object", "additionalProperties": { "type": "string" } },
    "timeoutMs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connect": { "type": "integer", "minimum": 1 },
        "read": { "type": "integer", "minimum": 1 }
      }
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "maxConnections": { "type": "integer", "minimum": 1 } }
    },
    "env": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "baseUrl": { "type": "string", "pattern": "^https?://" },
          "baseUrlRef": { "$ref": "#/$defs/varName" },
          "values": { "type": "object" }
        }
      }
    },
    "datasourceRef": { "type": "string" },
    "database": { "type": "string" },
    "collections": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "HTTP" } } },
      "then": { "required": ["env"] }
    },
    {
      "if": { "properties": { "kind": { "const": "MONGO" } } },
      "then": { "required": ["datasourceRef", "database", "collections"] }
    }
  ],
  "$defs": {
    "varName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "description": "Environment variable name" }
  }
}
