{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rupeek.com/l1/operation.schema.json",
  "title": "L1 operation definition",
  "description": "How one operation runs. Common fields apply to every kind; the rest belong to one kind.",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "kind"],
  "properties": {
    "op": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-zA-Z0-9_-]+)+$" },
    "version": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["HTTP", "MONGO", "MAP", "GEN"] },
    "resource": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "params": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["string", "int", "double", "bool", "map", "list", "dyn"] },
          "pii": { "type": "boolean" }
        }
      }
    },
    "out": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cel" } },
    "required": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "timeoutMs": { "type": "integer", "minimum": 1 },
    "idempotent": { "type": "boolean" },
    "audit": { "type": "string", "minLength": 1, "description": "Audit requestType, literal or =CEL" },
    "piiPaths": { "type": "array", "items": { "type": "string", "pattern": "^\\$" } },

    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "minLength": 1 },
        "query": { "type": "object" },
        "headers": { "type": "object" },
        "body": {},
        "bodyEncoding": { "enum": ["JSON", "FORM"] }
      }
    },
    "success": { "$ref": "#/$defs/cel" },
    "classify": { "$ref": "#/$defs/cel" },

    "collection": { "type": "string", "minLength": 1 },
    "action": { "type": "string" },
    "filter": { "type": "object" },
    "set": { "type": "object" },
    "setOnInsert": { "type": "object" },
    "inc": { "type": "object" },
    "sort": { "type": "object" },
    "projection": { "type": "object" },
    "limit": { "type": "integer", "minimum": 1 },
    "expect": { "type": "object" },

    "template": {}
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "HTTP" } } },
      "then": { "required": ["resource", "request"] }
    },
    {
      "if": { "properties": { "kind": { "const": "MONGO" } } },
      "then": {
        "required": ["resource", "collection", "action"],
        "properties": { "action": { "enum": ["FIND_ONE", "FIND_MANY", "INSERT", "UPDATE_ONE", "UPSERT"] } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "MAP" } } },
      "then": { "required": ["template"] }
    },
    {
      "if": { "properties": { "kind": { "const": "GEN" } } },
      "then": { "required": ["action"], "properties": { "action": { "enum": ["STABLE_ID", "NOW"] } } }
    }
  ],
  "$defs": {
    "cel": { "type": "string", "minLength": 1, "maxLength": 2000 }
  }
}
