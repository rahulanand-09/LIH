{
  "flowRef": "axis-precheck",
  "version": 1,
  "start": "dedupe",
  "nodes": [
    {
      "nodeType": "TASK",
      "id": "dedupe",
      "kind": "RECIPE",
      "taskRef": "axis.precheck.dedupe",
      "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "runNo": "$.in.runNo", "loanProcess": "$.in.loanProcess" },
      "onError": { "retries": 5, "then": "PARK" }
    },
    {
      "nodeType": "TASK",
      "id": "timble",
      "kind": "RECIPE",
      "taskRef": "axis.precheck.timble",
      "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "runNo": "$.in.runNo", "loanProcess": "$.in.loanProcess" },
      "onError": { "retries": 5, "then": "PARK" }
    },
    {
      "nodeType": "WAIT",
      "id": "waitCallback",
      "event": "timbleCallback",
      "timeout": null,
      "onTimeoutOutcome": null
    },
    {
      "nodeType": "TASK",
      "id": "timbleCallback",
      "kind": "RECIPE",
      "taskRef": "axis.precheck.timbleCallback",
      "fields": {},
      "in": { "event": "$.waitCallback.outputs" },
      "onError": { "retries": 3, "then": "PARK" }
    },
    {
      "nodeType": "TASK",
      "id": "status",
      "kind": "RECIPE",
      "taskRef": "axis.precheck.status",
      "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId" },
      "onError": { "retries": 5, "then": "PARK" }
    },
    {
      "nodeType": "TASK",
      "id": "notifyOk",
      "kind": "RECIPE",
      "taskRef": "precheck.notify.verified",
      "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId" },
      "onError": { "retries": 3, "then": "PARK" }
    },
    {
      "nodeType": "TASK",
      "id": "notifyFail",
      "kind": "RECIPE",
      "taskRef": "precheck.notify.failed",
      "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "lender": "axis" },
      "onError": { "retries": 3, "then": "PARK" }
    },
    { "nodeType": "END", "id": "approved", "status": "APPROVED" },
    { "nodeType": "END", "id": "rejected", "status": "REJECTED" },
    { "nodeType": "END", "id": "skipped", "status": "SKIPPED" }
  ],
  "edges": [
    { "from": "dedupe", "on": "IN_PROGRESS", "to": "skipped" },
    { "from": "dedupe", "on": "INITIATED", "to": "timble" },
    { "from": "dedupe", "on": "ALREADY_INITIATED", "to": "timble" },
    { "from": "dedupe", "on": "REJECTED", "to": "timble" },

    { "from": "timble", "on": "INITIATED", "to": "waitCallback" },
    { "from": "timble", "on": "ALREADY_INITIATED", "to": "waitCallback" },
    { "from": "timble", "on": "REJECTED", "to": "rejected" },

    { "from": "waitCallback", "on": "RECEIVED", "to": "timbleCallback" },

    { "from": "timbleCallback", "on": "TIMBLE_OK", "to": "status" },
    { "from": "timbleCallback", "on": "TIMBLE_FAILED", "to": "status" },
    { "from": "timbleCallback", "on": "NO_PRECHECK", "to": "rejected" },

    { "from": "status", "on": "SUCCESS", "to": "notifyOk" },
    { "from": "status", "on": "FAILURE", "to": "notifyFail" },
    { "from": "status", "on": "ALREADY_FINAL", "to": "approved" },
    { "from": "status", "on": "NO_PRECHECK", "to": "rejected" },
    { "from": "status", "on": "PENDING", "to": "status" },

    { "from": "notifyOk", "on": "NOTIFIED", "to": "approved" },
    { "from": "notifyOk", "on": "NOT_ACCEPTED", "to": "approved" },
    { "from": "notifyFail", "on": "NOTIFIED", "to": "rejected" },
    { "from": "notifyFail", "on": "NOT_ACCEPTED", "to": "rejected" }
  ]
}
