{
  "name": "precheck",
  "steps": [
    { "type": "CALL", "op": "dedupe" },
    { "type": "CALL", "op": "timble" },
    { "type": "PERSIST", "target": "precheckInit" },
    { "type": "WAIT", "until": "done == true" }
  ],
  "events": {
    "timbleCallback": {
      "steps": [
        { "type": "DECIDE", "as": "timbleOk", "expr": "!(#f.eqi(event['name_match'],'N') || #f.eqi(event['aadhar_match'],'N'))" },
        { "type": "PERSIST", "target": "timbleStatus" }
      ],
      "returns": ["timbleOk"]
    },
    "status": {
      "steps": [
        { "type": "CALL", "op": "status" },
        { "type": "DECIDE", "as": "flags", "expr": "{status['dedupe'], status['pan'], status['ramp'], status['hunter'], timbleOk == null ? 'WIP' : (timbleOk ? 'Y' : 'N')}" },
        { "type": "DECIDE", "as": "outcome", "expr": "#f.allEqual(flags,'Y') ? 'SUCCESS' : (#f.anyEqual(flags,'N') ? 'FAILURE' : 'PENDING')" },
        { "type": "DECIDE", "as": "done", "expr": "outcome != 'PENDING'" },
        { "type": "PERSIST", "target": "precheckStatus" },
        { "type": "NOTIFY", "target": "rupeekweb.verified", "when": "outcome == 'SUCCESS'" },
        { "type": "NOTIFY", "target": "rupeekweb.failed", "when": "outcome == 'FAILURE'" }
      ],
      "returns": ["outcome", "flags"]
    }
  }
}
