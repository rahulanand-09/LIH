{
  "flowRef": "axis-precheck-decomposed-coreAndStableId",
  "version": 1,
  "start": "core",
  "nodes": [
    { "nodeType": "TASK", "id": "core", "kind": "HTTP", "taskRef": "core.fetchCustomerByLoanRequest", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "existing", "kind": "MONGO", "taskRef": "precheck.findByLoanRequest", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId" }, "onError": { "retries": 5, "then": "PARK" } },
    { "nodeType": "TASK", "id": "seed", "kind": "MAP", "taskRef": "axis.decomposed.buildSeed", "fields": {},
      "in": { "loanRequestId": "$.in.loanRequestId", "runNo": "$.in.runNo" }, "onError": { "retries": 1, "then": "PARK" } },
    { "nodeType": "TASK", "id": "ids", "kind": "GEN", "taskRef": "gen.stableId", "fields": {},
      "in": { "seed": "$.seed.outputs.value" }, "onError": { "retries": 1, "then": "PARK" } },

    { "nodeType": "END", "id": "done", "status": "OK", "outputs": {
        "customer": "$.core.outputs.customer",
        "customerId": "$.core.outputs.customerId",
        "found": "$.existing.outputs.found",
        "doc": "$.existing.outputs.doc",
        "idsValue": "$.ids.outputs.value"
      } }
  ],
  "edges": [
    { "from": "core", "on": "OK", "to": "existing" },
    { "from": "existing", "on": "OK", "to": "seed" },
    { "from": "seed", "on": "OK", "to": "ids" },
    { "from": "ids", "on": "OK", "to": "done" }
  ]
}
